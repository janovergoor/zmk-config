#include <dt-bindings/zmk/matrix_transform.h>

#include "perpetual-layouts.dtsi"

// The physical layout carries the transform, so `zmk,matrix-transform` is NOT
// chosen here -- declaring both makes the layout and the chosen transform two
// competing answers to the same question. This mirrors how a board with
// physical layouts wires it up.
&default_layout {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    /*
     * Perpetual keyboard matrix layout (48-key version)
     *
     * Physical layout per side -- 24 keys, a FULL 6 x 4 grid with no free slots:
     * - 6 columns: extra, pinky, ring, middle, index, inner
     * - 4 rows: top, home, bottom, thumb
     *
     * Left side:  columns 0-5  (extra=0, pinky=1, ring=2, middle=3, index=4, inner=5)
     * Right side: columns 6-11 (inner=6, index=7, middle=8, ring=9, pinky=10, extra=11)
     *
     * Row 3 is NOT purely a thumb row. Two of its six slots are keys that sit
     * elsewhere on the board and borrow row_thumb because it was the only place
     * left to put them:
     *
     *   col 0 (extra)  = the ARROW key, physically below the RING column.
     *                    Wired to col_extra x row_thumb, not col_ring, because
     *                    24 keys into 6x4 is an exact fit and col_extra had the
     *                    only free thumb slot. Putting it on col_ring would have
     *                    forced a 5th matrix row for a single key.
     *   col 1 (pinky)  = the UNDER-MCU key, sitting in the gap beneath the
     *                    controller. The rotary encoder's push switch is wired
     *                    in PARALLEL with it, so pressing the encoder and
     *                    pressing this key are the same matrix event.
     *
     * Everything else on row 3 is the thumb cluster proper:
     *   col 2 = enc_thumb (a plain key now -- the encoder moved to col 1)
     *   col 3 = near_thumb, col 4 = mid_thumb, col 5 = far_thumb
     *
     * The map below is in NUMERIC RC order, which is also the order
     * perpetual.json emits its physical-layout entries in. Those two orders
     * define the same key-position indices and must not drift apart.
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
            // Row 0: Top row (6 + 6 = 12 keys)
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            // Row 1: Home row (6 + 6 = 12 keys)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)     RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            // Row 2: Bottom row (6 + 6 = 12 keys -- extra column now populated)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)     RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            // Row 3: arrow, under-MCU (= encoder push), then 4 thumb keys per side
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)     RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row_top
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row_home
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row_bottom
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row_thumb
            ;
    };

    // Encoder configuration.
    //
    // The encoder moved from the thumb cluster to the under-MCU position, but its
    // A/B wiring did not change: encoder_a is still on P0 and encoder_b on P1
    // (ergogen config.yaml, ceoloide/rotary_encoder_ec11_ec12). The a/b swap
    // between the two nodes compensates for the board being mirrored, so a
    // clockwise turn reads the same direction on both halves.
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <60>;
        status = "disabled";
    };

    right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <60>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <20>;
    };
};
